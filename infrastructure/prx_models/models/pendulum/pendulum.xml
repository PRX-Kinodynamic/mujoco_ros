<mujoco model="pendulum">
  <compiler angle="radian" />
  <size njmax="500" nconmax="100"/>
  <option timestep="0.002" integrator="Euler"/>
  <option>
      <flag multiccd="enable"/>
  </option>
  <asset>
    <texture name="texplane0" type="2d" builtin="checker" rgb1="0 0 0" rgb2="0.8 0.8 0.8" width="100" height="100" mark="cross" markrgb=".8 .8 .8"/>
    <material name="matplane0" reflectance="0.3" texture="texplane0" texrepeat="1 1" texuniform="true"/>
  </asset>
  <visual>
    <headlight ambient="0.6 0.6 0.6" diffuse="0.5 0.5 0.5" specular="0.2 0.2 0.2"/>
    <map znear="0.001" />
  </visual>
  <worldbody>
    <geom contype="1" friction="1 0 0.01" name="floor0" pos="0 0 0" euler="0 0 0" size="10 10 0.01" type="box" material="matplane0" condim="6"/> 

    <body name="fix_box" pos="0.0 0.0 2" euler="0 0 0.0">
        <geom  type="box"  name="fix_box" contype="1" conaffinity="1"  condim="6" 
               size="0.1 0.1 0.1"  pos="0 0 0" euler="0 0 0"  rgba="0.5 0 0 1.0"/>
        <body name="pendulum" pos="0.2 0.0 -0.5">
          <joint name="joint0" type="hinge" axis="1 0 0" limited="false" pos="0.0 0.0 0.5"
                   frictionloss="0.01" damping="0.1" armature="0.0002"  />
          <geom name="pendulum" type="box" contype="1" conaffinity="1" mass="0.5" 
                  size="0.1 0.1 0.5"  rgba="1 0 0 1.0"/>
          <body name="ball" pos="0. 0.0 -0.5">
            <geom name="ball" type="sphere" contype="1" conaffinity="1" mass="0.5" 
                  size="0.1414"  rgba="0 1 0 .5"/>
          </body>
        </body>
    </body>
  </worldbody>
    <actuator>
      <!-- <general gear="1" forcelimited="true" forcerange="-100 100" name="joint0_motor" -->
      <!-- joint="joint0" dyntype="integrator" /> -->
    <motor gear="1" forcelimited="true" forcerange="-10 10" name="joint0_motor" joint="joint0"/>
  </actuator>
  <sensor>
    <framepos name="global_position" objtype="xbody" objname="ball" reftype="xbody" refname="fix_box"/>
    <!-- <framequat name="global_orientation" objtype="xbody" objname="buddy" /> -->
  </sensor>
</mujoco>
