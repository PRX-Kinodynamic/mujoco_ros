<launch>
  
  <!-- <arg name = "stela_model" default="mushr" /> -->
  <!-- <arg name = "planning_model" default="mushr" /> -->

  <!-- <arg name="validation_plan_feasibility"/> -->
  <!-- <arg name="validation_collision_only"/> -->
  <!-- <arg name="replanning_condition"/> -->
  <!-- <arg name="cycle_duration"/> -->
