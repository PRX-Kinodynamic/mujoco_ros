  <!-- <arg name = "stela_plant_file" value="$(env ML4KP_ROS)/src/mujoco_ros/motion_planning/config/$(arg stela_model).yaml"/> -->
  <arg name = "planning_plant_file" value="$(env ML4KP_ROS)/src/mujoco_ros/motion_planning/config/mushr.yaml"/>

  <include file="$(find interface)/launch/stela.launch">
    <arg name="input_tree_topic_name" default="/mushr/sln/tree_dbg"/>
    
    <!-- <arg name="mushr_model" value="$(arg stela_model)" /> -->
    <!-- <arg name="params_file" default="$(arg stela_plant_file)"/> -->

    <!-- <arg name="validation_plan_feasibility" value="$(arg validation_plan_feasibility)"/> -->
    <!-- <arg name="validation_collision_only" value="$(arg validation_collision_only)"/> -->
    <!-- <arg name="replanning_condition" value="$(arg replanning_condition)"/> -->
    <!-- <arg name="cycle_duration" value="$(arg cycle_duration)"/> -->
    <!-- <arg name="replanning_iterations" value="$(arg replanning_iterations)"/> -->
  </include>

  <!-- <include file="$(find task_planning)/launch/fix_plan.launch"/> -->
  
  <include file="$(find task_planning)/launch/kraft.launch">
    <arg name="plant_file" default="$(arg planning_plant_file)"/>
  </include>

</launch>
