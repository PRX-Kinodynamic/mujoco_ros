<launch>
    <arg name="stop_topic" value="/tools/stop"/>
    <arg name="experiment_id" default=""/>
    <arg name="camera0_topic" default="/perception/logitech_brio_73B6FC82/aruco/rgb"/>
    <arg name="camera1_topic" default="/perception/logitech_brio_96214279/aruco/rgb"/>
    <!-- <arg name="output_dir" default="/common/users/eg585/stela_kraft"/> -->
    <!-- <arg name="output_dir" default="$(env ML4KP_ROS)/bags"/> -->
    <arg name="record_video" default="true"/>

    <group ns="tools">
        <node pkg="interface" type="rosbag_record" name="rosbag_record" 
            output="screen"
            >
            <rosparam command="load" file="$(find interface)/config/rosbag_record.yaml" />
            <param name="rosbag_directory" value="$(arg output_dir)"/>
            <param name="stop_topic" value="$(arg stop_topic)"/>
        </node>

        <node if="$(arg record_video)" 
            pkg="interface" type="topic_to_video" name="topic_to_video" 
            output="screen">
            <param name="stop_topic" value="$(arg stop_topic)"/>
            <param name="video_directory" value="$(arg output_dir)"/>
            <param name="width" value="1980"/>
            <param name="height" value="1080"/>
            <param name="image_topic" value="$(arg camera0_topic)"/>
            <param name="video_id" value="$(arg experiment_id)_C0"/>
        </node>

        <node if="$(arg record_video)" 
            pkg="interface" type="topic_to_video" name="topic_to_video_robb"
            output="screen">
            <param name="stop_topic" value="$(arg stop_topic)"/>
            <param name="video_directory" value="$(arg output_dir)"/>
            <param name="width" value="1980"/>
            <param name="height" value="1080"/>
            <param name="image_topic" value="$(arg camera1_topic)"/>
            <param name="video_id" value="$(arg experiment_id)_C1"/>
        </node>  

    </group>
  
</launch>