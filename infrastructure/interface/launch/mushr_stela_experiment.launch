  <!-- <arg name="total_experiments" default="1"/> -->
  <arg name="rosbag_directory" default="$(env ML4KP_ROS)/bags/mj_experiments/" />

  <node pkg="interface" type="mushr_experiments" name="mushr_experiments" 
        output="screen">
      <param name="node_id" value="experiment_runner"/>
