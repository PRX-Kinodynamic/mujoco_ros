<launch>

  <!-- <arg name="environment" default="$(env DIRTMP_PATH)/resources/input_files/environments/boxes.yaml"/> -->
  <!-- <arg name="environment" default="$(env DIRTMP_PATH)/resources/input_files/environments/empty.yaml"/> -->
  <!-- <arg name="environment" default="$(env DIRTMP_PATH)/resources/input_files/environments/walls.yaml"/> -->
  <arg name="environment" default="$(env DIRTMP_PATH)/resources/input_files/environments/single_box.yaml"/>
  <arg name="goal" default="[1.0, 5.0, 0.0]"/>
  <arg name="goal_radius" default="1.0"/>
  <arg name="timeout" default="120"/>
  <!-- <arg name="timeout" default="60"/> -->
  <arg name="experiment" default="test"/>
  <arg name="file_prefix" default="$(env ML4KP_ROS)/data/experiments/test"/>
  <arg name="total_experiments" default="1"/>
	<!-- <include file="$(find mujoco_ros)/launch/mushr.launch"> -->
    <!-- <arg name="publish_ground_truth_pose" value="false" /> -->
    <!-- <arg name="environment" value="$(arg environment)" /> -->
  <!-- </include> -->
  <node pkg="interface" type="mushr_experiments" name="mushr_experiments" 
        output="screen">
      <param name="node_id" value="experiment_runner"/>
      <param name="goal" type="yaml" value="$(arg goal)"/>
      <param name="timeout" value="$(arg timeout)"/>
      <param name="file_prefix" value="$(env ML4KP_ROS)/data/experiments/$(arg experiment)"/>
      <param name="total_experiments" value="$(arg total_experiments)"/>
      <param name="goal_radius" value="$(arg goal_radius)"/>
      <param name="stela_node_id" value="stela"/>
      <param name="mj_node_id" value="mujoco"/>
      <param name="rosbag_node_id" value="rosbag_recorder"/>
      <param name="sensor_topic_name" value="/mushr/sensordata"/>
      <param name="collision_topic_name" value="/mushr/collision"/>
  </node>

  <!-- <include file="$(find interface)/launch/stela.launch"> -->
    <!-- <arg name="experiment_id" default=""/> -->
    <!-- <arg name="camera0_topic" default="/perception/logitech_brio_73B6FC82/aruco/rgb"/> -->
    <!-- <arg name="camera1_topic" default="/perception/logitech_brio_96214279/aruco/rgb"/> -->
    <!-- <arg name="rosbag_directory" /> -->
    <!-- <arg name="record_video" default="true"/> -->
    <!-- <arg name="rosbag_prefix" default=""/> -->
  <!-- </include> -->

  <!-- <include file="$(find interface)/launch/stela.launch"> -->
    <!-- <arg name="input_tree_topic_name" default="/mushr/sln/tree_dbg"/> -->
    <!-- <arg name="environment" value="$(arg environment)" /> -->
    <!-- <arg name="mushr_model" value="analytical" /> -->
    <!-- <arg name="mushr_model" value="torch" /> -->
    <!-- <arg name="mushr_model" value="mujoco" /> -->
    <!-- <arg name="params_file" default="$(env ML4KP_ROS)/src/mujoco_ros/motion_planning/config/mushr.yaml"/> -->
    <!-- <arg name="params_file" default="$(env ML4KP_ROS)/src/mujoco_ros/motion_planning/config/mushr_mujoco.yaml"/> -->
    <!-- <arg name="params_file" default="$(env ML4KP_ROS)/src/mujoco_ros/motion_planning/config/mushr_torch.yaml"/> -->
  <!-- </include> -->

  <!-- <include file="$(find task_planning)/launch/fix_plan.launch"/> -->
  
  <include file="$(find interface)/launch/rosbag_record_mj_experiment.launch">
    <arg name="rosbag_directory" value="$(env ML4KP_ROS)/bags/mj_experiments/" />
    <arg name="rosbag_prefix" default="$(arg experiment)"/>
  </include>

  <!-- <include file="$(find task_planning)/launch/kraft.launch"> -->
    <!-- <arg name="environment" value="$(arg environment)" /> -->
  <!-- </include> -->

</launch>