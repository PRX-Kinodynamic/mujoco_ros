<launch>

    <arg name="rosbag_directory" />
    <arg name="rosbag_prefix" default=""/>

    <group ns="tools">
        <node pkg="interface" type="rosbag_record" name="rosbag_record" output="screen"
            >
            <rosparam command="load" file="$(find interface)/config/rosbag_mj_experiments.yaml" />
            <param name="rosbag_directory" value="$(arg rosbag_directory)"/>
            <param name="node_id" value="rosbag_recorder"/>
            <param name="rosbag_prefix" value="$(arg rosbag_prefix)"/>
            <param name="verbose" value="true"/>
        </node>
    </group>
  
</launch>