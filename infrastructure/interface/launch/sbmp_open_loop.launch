<launch>
    <arg name="plant_file" default="$(env ML4KP_ROS)/src/mujoco_ros/motion_planning/config/mushr.yaml"/>
    <arg name = "output_dir" default="$(env ML4KP_ROS)/data/"/>
    <arg name="random_seed" default="112392"/>

    <arg name="cycle_duration" value="1.0"/>

    <param name="random_seed" value="$(arg random_seed)"/>
    <param name="simulation_step" value="0.1"/>
    <param name="plant_parameters" textfile="$(arg plant_file)" />

    <include file="$(find estimation)/launch/mushr_ekf.launch"/>

    <node pkg="motion_planning" type="sbmp_open_loop" name="sbmp_open_loop" 
        output="screen">
        <param name="node_id" value="sbmp_open_loop" />
        <param name="experiments_node_id" value="experiment_runner" />
        <param name="replanner_service" value="/dirt/replan"/>
        <param name="planner_clock_topic" value="/motion_planning/clock"/>
        <param name="ekf_topic" value="/mushr/ekf"/>
        <param name="replanner_solution_duration" value="1"/>
        <param name="cycle_duration" value="$(arg cycle_duration)"/>
        <param name="control_topic" value="/mushr/plan_stepper/control"/>
        <param name="lm/iterations" value="10"/>
        <!-- <param name="stamped_estimation_topic" value="/mushr/ekf"/> -->
    </node> 

    <node pkg="task_planning" name="replanner" type="mushr_replanning_dirt" 
          output="screen" respawn="false" >
        <param name="node_id" value="replanner" />
        <param name="experiments_node_id" value="experiment_runner" />
        <param name="heuristic_map_filename" value="$(arg output_dir)/heuristic_map.txt"/>
        <param name="planner_stats_topic_name" value="/replanner/stats" />
        <param name="estimation_tree_topic" value="/stela/estimation/tree"/>
        <param name="planner_clock_topic" value="/motion_planning/clock"/>
        <param name="sbmp_full_tree_topic" value="/mushr/tree"/>
        <param name="sbmp_solution_tree_topic" value="/mushr/sln/tree"/>
        <param name="max_edge_duration" value="0.1"/>
    </node>

    <node pkg="nodelet" type="nodelet" name="sbmp_nodelet"  args="manager" output="screen"/>

    <node pkg="nodelet" type="nodelet" name="MotionPlanningTreeVizPublisher" 
        args="load motion_planning/MotionPlanningTreeVizPublisher sbmp_nodelet" 
        output="screen">
        <param name="tree_topic_name" value="/mushr/tree" />
        <param name="color" type="yaml" value="[1.0, 1.0, 0.0, 1.0]" />
        <param name="scale" value="0.1" />
    </node>     

    <node pkg="nodelet" type="nodelet" name="MotionPlanningSlnTreeVizPublisher" 
        args="load motion_planning/MotionPlanningTreeVizPublisher sbmp_nodelet" 
        output="screen">
        <param name="tree_topic_name" value="/mushr/sln/tree" />
        <param name="color" type="yaml" value="[1.0, 0.0, 0.8, 1.0]" />
        <param name="scale" value="0.2" />
    </node>     
</launch>

