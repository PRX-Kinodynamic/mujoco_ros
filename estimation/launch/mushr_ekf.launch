<launch>

  <arg name="sensor_topic_name" default="/mushr/sensordata"/>
  <arg name="control_topic" default="/mushr/control"/>
  <arg name="estimation_topic" default="/mushr/ekf"/>

  <node pkg="estimation" type="mushr_kalman" name="mushr_kalman" output="screen">
    <param name="sensor_topic_name" value="$(arg sensor_topic_name)"/>
    <param name="control_topic" value="$(arg control_topic)"/>
		<param name="estimation_topic" value="$(arg estimation_topic)"/>
    <param name="simulator_node_id" value="mujoco"/>
    <param name="implicit" value="true"/>
  </node>   

  <node pkg="nodelet" type="nodelet" name="SpacepointToMarkerPublisher"
      args="standalone interface/SpacepointToMarkerPublisher " output="screen">
    <param name="world_frame" value="world"/>
    <param name="spacepoint_topic_name" value="$(arg estimation_topic)"/>
    <param name="color" type="yaml" value="[0.8, 0.0, .78, 1.0]"/>
  </node>

</launch>