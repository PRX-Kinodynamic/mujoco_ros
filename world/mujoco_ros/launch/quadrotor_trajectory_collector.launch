<launch>
    <arg name="step_size" default="0.01" />
    <!-- <arg name="real_time" default="false"/> -->
    <arg name="real_time" default="true"/>
    <arg name="random_seed" default="112392"/>

    <!-- <arg name="model_path" default="$(find prx_models)/models/bitcraze_crazyflie_2/scene.xml" /> -->
    <arg name="model_path" default="$(find prx_models)/models/skydio_x2/scene.xml" />
    <arg name="steps_bounds" default="[2, 8]" />
    <arg name="u0_bounds_min" default="[3.0, 3.0, 3.0, 3.0]" />
    <arg name="control_bounds_min" default="[0.0, 0.0, 0.0, 0.0]" />
    <arg name="control_bounds_max" default="[13.0, 13.0, 13.0, 13.0]" />

    <arg name="visualize_sim" default="true" />
    <arg name="sensor_frequency" default="30" />
    <arg name="total_trajectories" default="1" />
    <arg name="min_trajectory_duration" default="10" />
    <arg name="total_simulations" default="1"/>
    <arg name="data_topic"  default="/mj/plan_trajectory"/>
    <arg name="sensor_topic" value="/mujoco/sensor" />

    <!-- <arg name="camera_config_file" default="$(find mujoco_ros)/config/mushr_mujoco_cam_0.yaml"/> -->
    
    <!-- <param name="environment" textfile="$(find prx_models)/models/environments/$(arg environment).yaml" /> -->

    <group ns="mushr">
        <node pkg="mujoco_ros" name="simulation" type="quadrotor_trajectory_collector" output="screen" required="true">
            <param name="real_time" value="$(arg real_time)"/>
            <param name="random_seed" value="$(arg random_seed)"/>
            <param name="model_path" type="string" value="$(arg model_path)"/>
            <param name="data_topic" type="string" value="$(arg data_topic)"/>
            <param name="total_simulations" value="$(arg total_simulations)"/>
            <param name="sensor_frequency" value="$(arg sensor_frequency)" />
            <param name="step_size" value="$(arg step_size)" />
            <param name="model_path" value="$(arg model_path)" />
            <param name="steps_bounds" type="yaml" value="$(arg steps_bounds)" />
            <param name="u0_bounds_min" type="yaml" value="$(arg u0_bounds_min)" />
            <param name="u0_bounds_max" type="yaml" value="$(arg control_bounds_max)" />
            <param name="control_bounds_min" type="yaml" value="$(arg control_bounds_min)" />
            <param name="control_bounds_max" type="yaml" value="$(arg control_bounds_max)" />
            <param name="visualize_sim" value="$(arg visualize_sim)" />
            <param name="total_trajectories" value="$(arg total_trajectories)" />
            <param name="min_trajectory_duration" value="$(arg min_trajectory_duration)" />
            <param name="sensor_topic" value="$(arg sensor_topic)" />
            <!-- <param name="node_id" value="mujoco" /> -->
            <!-- <param name="collision_topic" value="/mushr/collision"/> -->
        </node>
    </group>

    <!-- <node pkg="nodelet" type="nodelet" name="mj_nodelet"  args="manager" output="screen"/> -->

    <!-- <node pkg="nodelet" type="nodelet" name="EnvironmentPublisher"  -->
        <!-- args="load utils/EnvironmentPublisher mj_nodelet"  -->
        <!-- output="screen"> -->
    <!-- </node>    -->

    <node pkg="nodelet" type="nodelet" name="SensorToMarkerPublisher"
      args="standalone interface/SensorToMarkerPublisher " output="screen">
        <param name="world_frame" value="world"/>
        <param name="sensor_topic_name" value="$(arg sensor_topic)"/>
        <param name="scale" type="yaml" value="[0.2, 0.2, 0.2]"/>
        <param name="color" type="yaml" value="[0.8, 0.0, .78, 1.0]"/>
        <param name="sensor_map" type="yaml" value="[10, 11, 12, 6, 7, 8, 9]"/>
    </node>

    <node pkg="tf2_ros" type="static_transform_publisher" name="tf_world"
        args="0 0 0 0 0 0 1  marker_50 world" />
    
   
</launch>

