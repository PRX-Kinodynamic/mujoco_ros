<launch>
    <!-- <arg name="environment"/> -->
    <!-- <arg name="plant_file" default="$(env ML4KP_ROS)/src/mujoco_ros/motion_planning/config/mushr.yaml"/> -->
    <arg name="environment" default="SO2_single_obstacle"/>
    <arg name="plant_file" default="$(env ML4KP_ROS)/src/mujoco_ros/motion_planning/config/SO2_system.yaml"/>
    <arg name="problem_parameters" default="$(env ML4KP_ROS)/src/mujoco_ros/motion_planning/config/SO2_problem_0.yaml"/>
    <!-- <arg name="environment" default="$(env ML4KP_ROS)/src/mujoco_ros/motion_planning/config/single_obstacle.yaml"/> -->

    <!-- <param name="environment" textfile="$(find prx_models)/models/environments/$(arg environment).yaml" /> -->
    <!-- <param name="environment" textfile="$(find prx_models)/models/environments/$(arg environment).yaml" /> -->
    <!-- <rosparam command="load" file="$(find prx_models)/models/environments/$(arg environment).yaml" /> -->

    <param name="simulation_step" value="0.1"/>
    <param name="plant_parameters" textfile="$(arg plant_file)"/>
    <param name="problem_parameters" textfile="$(arg problem_parameters)"/>
    <param name="environment" textfile="$(find prx_models)/models/environments/$(arg environment).yaml" />

        <!-- launch-prefix="lldb - -" -->
    <node pkg="analytical" type="simulator" name="simulator" 
        output="screen" >
        <param name="node_id" value="analytical_simulator" />
        <param name="plant_name" value="SO2_system" />
        <param name="collision_topic" value="/mushr/collision" />
        <param name="simulation_step" value="0.1" />
        <param name="ctrl_topic"      value="/stela/sbmp/control" />
        <param name="sensor_topic"    value="/mushr/sensordata" />
        <param name="set_state_topic"    value="/mushr/set_state" />
        <!-- <rosparam command="load" file="$(arg plant_file)" /> -->
    </node>

    <node pkg="nodelet" type="nodelet" name="analytical_sim_aux_nodelet"  args="manager" output="screen"/>

    <node pkg="nodelet" type="nodelet" name="SensorToMarkerPublisher" 
        args="load interface/SensorToMarkerPublisher analytical_sim_aux_nodelet" 
        output="screen">
        <param name="world_frame" value="world" />
        <param name="sensor_topic_name" value="/mushr/sensordata" />
    </node>

     <node pkg="nodelet" type="nodelet" name="EnvironmentPublisher" 
        args="load utils/EnvironmentPublisher analytical_sim_aux_nodelet" 
        output="screen">
    </node>  
    
    <node pkg="tf2_ros" type="static_transform_publisher" name="tf_world_sim"
        args="0 0 0 0 0 0 1  marker_sim world" />
</launch>
